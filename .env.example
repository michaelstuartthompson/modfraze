# ModFraze — copy this file to .env and fill in real values.
# .env is gitignored. Never commit it.

# ---------------------------------------------------------------------------
# REQUIRED — the trend scout agent will not run without this
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
MODFRAZE_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# OPTIONAL — trend sources. Each unset key just makes that adapter return [].
# ---------------------------------------------------------------------------
APIFY_API_KEY=                # TikTok ingestion (integrations/tiktok_adapter.py)
APIFY_TIKTOK_ACTOR=           # actor id; see pipeline/ingest_tiktok.py
APIFY_TIKTOK_QUERY=
APIFY_TIKTOK_MAX_ITEMS=50
RAPIDAPI_KEY=                 # alternate TikTok source
# --- Etsy: the only source that measures money instead of attention --------
# Get a keystring from https://www.etsy.com/developers/your-apps
# Requires an approved Personal App. Human review; apply early.
ETSY_KEYSTRING=               # keystring alone; if you get 401, use
                              # keystring:shared_secret in this same variable
# RATE LIMIT: an UNAPPROVED app gets 5 requests per DAY. Leave the values
# below alone until Etsy approves you, then raise to roughly 5 / 500.
ETSY_MAX_REQUESTS=1           # requests per run. Approved apps get 10,000/day.
ETSY_MAX_LISTINGS=100         # 100 listings = 1 request (100 is the page max)
ETSY_TAXONOMY_IDS=            # optional, comma-separated. Blank = all categories.
                              # Each id costs its own request -- with a 5/day
                              # quota, use one or none.
                              # Find ids at /v3/application/seller-taxonomy/nodes
X_API_KEY=                    # X / Twitter, via `pip install xdk`
X_API_SECRET=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=             # only needed if the public .json endpoints rate-limit
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ModFraze-TrendScout/0.1

# ---------------------------------------------------------------------------
# OPTIONAL — commerce (January build: integrations/, pipeline/)
# Names below are the exact strings the code reads. Verified with setup_check.py.
# ---------------------------------------------------------------------------
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=
SHOPIFY_SHOP_NAME=            # e.g. modfraze  (not the full domain)
SHOPIFY_STORE_URL=            # e.g. modfraze.myshopify.com
SHOPIFY_ACCESS_TOKEN=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=

# ---------------------------------------------------------------------------
# OPTIONAL — runtime switches and paths (pipeline/run_daily.py)
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///db/modfraze.db
DESIGN_OUTPUT_DIR=assets/generated
RUN_DEMO=1                    # 1 = fixtures only, no network
RUN_TIKTOK=0

# ---------------------------------------------------------------------------
# OPTIONAL — notifications
# agents/trend_scout/notify.py uses SMTP; the January build used SendGrid/Slack.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=michaelstuartthompson1@gmail.com
SENDGRID_API_KEY=
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# LEGACY — from the January build. Not used by the current agent.
# Revoke these rather than carry them forward.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
