# Viral Merch Pipeline - Environment Variables
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ============================================================================
# Database
# ============================================================================
DATABASE_URL=sqlite:///./viral_merch.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/viral_merch

# ============================================================================
# OpenAI / DALL-E
# ============================================================================
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DESIGN_OUTPUT_DIR=./generated_designs

# ============================================================================
# Apify (TikTok/Twitter Scraping)
# ============================================================================
APIFY_API_KEY=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TikTok settings
APIFY_TIKTOK_QUERY=trending tiktok videos
APIFY_TIKTOK_MAX_ITEMS=10
APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper

# Twitter settings
APIFY_TWITTER_QUERY=trending tweets
APIFY_TWITTER_MAX_ITEMS=20
APIFY_TWITTER_ACTOR=apidojo/twitter-scraper

# ============================================================================
# Reddit
# ============================================================================
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=viral_merch_bot/1.0

# ============================================================================
# Shopify
# ============================================================================
SHOPIFY_SHOP_NAME=your-store-name
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_STORE_URL=https://your-store-name.myshopify.com

# ============================================================================
# Printify
# ============================================================================
PRINTIFY_API_KEY=your_printify_api_key
PRINTIFY_SHOP_ID=12345678

# ============================================================================
# Meta (Facebook/Instagram) Ads
# ============================================================================
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_AD_ACCOUNT_ID=act_1234567890
META_PAGE_ID=1234567890  # Your Facebook Page ID

# ============================================================================
# Etsy (Optional)
# ============================================================================
ETSY_API_KEY=your_etsy_api_key
ETSY_API_SECRET=your_etsy_api_secret

# ============================================================================
# Notifications (Optional)
# ============================================================================
# Email (SendGrid)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTIFICATION_EMAIL=your@email.com

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# SMS (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# Prefect Cloud (Optional)
# ============================================================================
PREFECT_API_KEY=pnu_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/[account-id]/workspaces/[workspace-id]

# ============================================================================
# Pipeline Settings
# ============================================================================
# Which sources to run
RUN_TIKTOK=1
RUN_REDDIT=0
RUN_TWITTER=0
RUN_DEMO=0

# Performance thresholds
MIN_VIRALITY_SCORE=0.6
MIN_CTR_THRESHOLD=0.5
GOOD_CTR_THRESHOLD=2.0
MIN_CAMPAIGN_RUNTIME_HOURS=12

# Budget limits
DEFAULT_DAILY_BUDGET=5.0
MAX_DAILY_BUDGET=50.0
